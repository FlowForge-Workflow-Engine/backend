# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
STAGE=dev
PORT=3000

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DATABASE=workflow-engine
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Alternative database URL format (if needed)
# DATABASE_URL=postgresql://postgres:sipusipu18@localhost:5432/workflow-engine

# Session Management (PostgreSQL-based sessions)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_PORT=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=my-super-secret-token-for-jwt-change-in-production
JWT_EXPIRES_IN=24h
EXPIRES_IN=24h
JWT_REFRESH_EXPIRY_DAYS=7

# Session Management
SESSION_SECRET=strongSecretKey-change-in-production

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# ThrottlerGuard Configuration (Global backup rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=2000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Configuration (MailTrap for development)
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_FROM=noreply@workflow-engine.com

# Production SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# =============================================================================
# NATS MESSAGE BROKER
# =============================================================================
NATS_URL=nats://localhost:4222

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# Google OAuth2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FR_BASE_URL=http://localhost:3000

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_SECRET_NAME=
AWS_PUBLIC_BUCKET_NAME=

# =============================================================================
# APPLICATION METADATA (Auto-populated by npm)
# =============================================================================
# These are automatically set by npm from package.json
# npm_package_name=workflow-engine
# npm_package_version=0.0.1

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME=workflow-engine

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
# For development environment
LOG_LEVEL=debug

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CSRF Protection (automatically set based on NODE_ENV)
# CSRF_SECRET=auto-generated-in-production

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
# Health check endpoints use the above Redis and NATS URLs

# =============================================================================
# NOTES
# =============================================================================
# 1. Change all secrets and passwords in production
# 2. Use environment-specific files (.env.stage.prod, .env.stage.staging)
# 3. Never commit production secrets to version control
# 4. Consider using AWS Secrets Manager for production secrets
# 5. THROTTLE_LIMIT is set high (2000) to let EnhancedRateLimitMiddleware handle primary rate limiting